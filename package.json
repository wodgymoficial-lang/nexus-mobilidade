{
  "name": "relph-nexus-mobilidade",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.9.0" },
  "overrides": { "effect": "^3.20.0", "deepmerge-ts": "^8.0.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
