# Execute npm run setup:docker para gerar .env.docker com valores aleatórios.
# Este exemplo não contém credenciais reais.
APP_URL="http://127.0.0.1:3000"
APP_BIND="127.0.0.1"
APP_PORT="3000"
MYSQL_PASSWORD="__MYSQL_PASSWORD__"
MYSQL_ROOT_PASSWORD="__MYSQL_ROOT_PASSWORD__"
DATABASE_URL="mysql://nexus:__MYSQL_PASSWORD__@mysql:3306/nexus_mobilidade?connect_timeout=10"
AUTH_SECRET="__AUTH_SECRET__"
ENCRYPTION_KEY="__ENCRYPTION_KEY__"
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD_HASH="__ADMIN_PASSWORD_HASH__"
